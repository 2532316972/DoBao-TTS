# ============================================
# DoBao-TTS 环境变量示例
# 复制为 .env 并按需填写；.env 已被 .gitignore 忽略，绝不提交
# ============================================

# ---- 服务 ----
PORT=3000
HOST=127.0.0.1

# ---- 用户统计云端同步（默认关闭）----
# 只有把 GITEE_SYNC_ENABLED 设为 true 且配置了令牌，才会向 Gitee 同步统计数据
GITEE_SYNC_ENABLED=false
GITEE_SYNC_TOKEN=
GITEE_SYNC_OWNER=
GITEE_SYNC_REPO=AnnouncementManager
GITEE_SYNC_PATH=DoBao-TTS/user-stats.json
GITEE_SYNC_BRANCH=master

# ---- 公告源（公开读，无需令牌）----
GITEE_ANNOUNCEMENT_OWNER=YeYuRaoXinXian
GITEE_ANNOUNCEMENT_REPO=AnnouncementManager
GITEE_ANNOUNCEMENT_PATH=DoBao-TTS/announcement.json
GITEE_ANNOUNCEMENT_BRANCH=master

# ---- 在线文档源（公开读，无需令牌）----
GITEE_DOCS_OWNER=YeYuRaoXinXian
GITEE_DOCS_REPO=AnnouncementManager
GITEE_DOCS_PATH=DoBao-TTS/docs
GITEE_DOCS_BRANCH=master
